{
  "name": "newtab",
  "version": "1.11.0",
  "description": "Custom new tab extension",
  "keywords": [
    "browser",
    "chrome",
    "extension",
    "newtab"
  ],
  "homepage": "https://github.com/xzy-nine/newtab",
  "bugs": {
    "url": "https://github.com/xzy-nine/newtab/issues"
  },
  "license": "MIT",
  "author": "xzy-nine",
  "repository": {
    "type": "git",
    "url": "https://github.com/xzy-nine/newtab.git"
  },
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "compile": "tsc --noEmit",
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "instantiate-template": "node scripts/instantiate-template.mjs --instantiate",
    "knip": "knip",
    "lint": "oxfmt --no-error-on-unmatched-pattern && oxlint --fix --no-error-on-unmatched-pattern",
    "postinstall": "wxt prepare",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "test:unit": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify-agent-note-classification": "tsx scripts/verify-agent-note-classification.ts",
    "verify-agent-note-format": "tsx scripts/verify-agent-note-format.ts",
    "verify-all": "tsx scripts/verify-all.ts",
    "verify-archived-agent-notes": "tsx scripts/verify-archived-agent-notes.ts",
    "verify-doc-budgets": "tsx scripts/verify-doc-budgets.ts",
    "verify-md-links": "tsx scripts/verify-md-links.ts",
    "verify-md-wrap": "tsx scripts/verify-md-wrap.ts",
    "verify-skill-invocation-metadata": "tsx scripts/verify-skill-invocation-metadata.ts",
    "verify-template-placeholders": "tsx scripts/verify-template-placeholders.ts",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.0",
    "@reactuses/core": "^6.5.9",
    "@tailwindcss/vite": "^4.3.0",
    "ai": "^7.0.109",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "feedsmith": "^3.0.1",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.43",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "knip": "^6.15.0",
    "lint-staged": "^17.0.7",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "semantic-release": "^25.0.3",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wxt": "^0.20.26"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern --write",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.json": "oxfmt --no-error-on-unmatched-pattern --write"
  },
  "packageManager": "pnpm@11.21.0"
}
